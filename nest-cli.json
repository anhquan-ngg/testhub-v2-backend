{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "submission/fonts/*.woff2"
      },
      {
        "include": "../generated/**/*",
        "outDir": "./generated",
        "watchAssets": true
      }
    ]
  }
}

