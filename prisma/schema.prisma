// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  LECTURER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ExamMode {
  MANUAL
  RANDOM_N
  BY_TYPE
  BY_CHAPTER
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

enum QuestionFormat {
  KNOWLEDGE
  UNDERSTANDING
  APPLYING
  ADVANCED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionRating {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FileType {
  AUDIO
  IMAGE
  VIDEO
}

enum FileStatus {
  PENDING
  ACTIVE
  EXTERNAL
  DELETED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  SYSTEM
}

enum QuestionImportSourceType {
  DOCX
  XLSX
}

enum QuestionImportStatus {
  UPLOADING
  QUEUED
  PARSING
  REVIEW_REQUIRED
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

enum QuestionImportItemStatus {
  VALID
  INVALID
  COMMITTED
  SKIPPED
}

enum QuestionGenerationBatchStatus {
  QUEUED
  GENERATING
  REVIEW_REQUIRED
  FAILED
  COMPLETED
}

enum QuestionGenerationItemStatus {
  VALID
  APPROVED
  INVALID
  REJECTED
  COMMITTED
  SKIPPED
}

enum QuestionGenerationReviewAction {
  EDIT
  APPROVE
  REJECT
  COMMIT
}

enum QuestionGenerationAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum ExamViolationType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  CONNECTION_LOST
  COPY
  PASTE
}

enum ExamViolationSource {
  CLIENT
  SERVER
}

model User {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt
  full_name             String
  email                 String             @unique
  password              String?
  role                  UserRole           @default(STUDENT)
  status                UserStatus         @default(ACTIVE)
  school                String?
  phone                 String?
  address               String?
  accounts              Account[]
  exams                 Exam[]
  topics                Topic[]
  submissions           Submission[]
  registrations         ExamRegistration[]
  violations            ExamViolation[]
  retryGrantsReceived   ExamRetryGrant[]   @relation("ExamRetryGrantStudent")
  retryGrantsGiven      ExamRetryGrant[]   @relation("ExamRetryGrantGranter")
  receivedNotifications Notification[]     @relation("ReceivedNotifications")
  sentNotifications     Notification[]     @relation("SentNotifications")
  files                 File[]             @relation("UploadedFiles")
  questionImports       QuestionImport[]
  questionGenerationBatches QuestionGenerationBatch[]
  questionGenerationReviews QuestionGenerationReview[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted         Boolean   @default(false)
  deleted_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user_id            String    @db.Uuid
  provider           String    @default("local")
  provider_id        String?
  refresh_token_hash String?
  expires_at         BigInt?
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider])
  @@map("accounts")
}

model Exam {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted      Boolean            @default(false)
  deleted_at      DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  lecturer_id     String             @db.Uuid
  topic_id        String             @db.Uuid
  title           String
  exam_start_time DateTime
  exam_end_time   DateTime
  duration        Int
  practice        Boolean            @default(false)
  mode            ExamMode           @default(MANUAL)
  sample_size     Int?
  distribution    String?
  is_public       Boolean            @default(false)
  submissions     Submission[]
  questions       ExamQuestions[]
  registrations   ExamRegistration[]
  violations      ExamViolation[]
  retryGrants     ExamRetryGrant[]
  questionImports QuestionImport[]
  lecturer        User               @relation(fields: [lecturer_id], references: [id], onDelete: Cascade)
  topic           Topic              @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([lecturer_id])
  @@index([topic_id])
  @@map("exams")
}

model Topic {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  created_by String    @db.Uuid
  name       String

  exams           Exam[]
  chapters        Chapter[]
  creator         User             @relation(fields: [created_by], references: [id], onDelete: Cascade)
  questionImports QuestionImport[]
  questionGenerationBatches QuestionGenerationBatch[]

  @@index([created_by])
  @@map("topics")
}

model Chapter {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted             Boolean              @default(false)
  deleted_at             DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  topic_id               String               @db.Uuid
  parent_id              String?              @db.Uuid
  name                   String
  order                  Int
  topic                  Topic                @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  parent                 Chapter?             @relation("ChapterToChapter", fields: [parent_id], references: [id], onDelete: Cascade)
  children               Chapter[]            @relation("ChapterToChapter")
  questions              Question[]
  defaultQuestionImports QuestionImport[]     @relation("QuestionImportDefaultChapter")
  questionImportItems    QuestionImportItem[] @relation("QuestionImportItemChapter")
  questionGenerationBatches QuestionGenerationBatch[]

  @@index([topic_id, order])
  @@index([parent_id])
  @@map("chapters")
}

model Submission {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted  Boolean               @default(false)
  deleted_at  DateTime?
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  exam_id     String                @db.Uuid
  student_id  String                @db.Uuid
  total_score Decimal?              @db.Decimal(10, 2)
  rating      SubmissionRating?
  start_time  DateTime?
  end_time    DateTime?
  status      SubmissionStatus      @default(IN_PROGRESS)
  /// Effective auto-submit deadline for this attempt. Set at start (now +
  /// duration, capped by exam_end_time) and pushed back by a lecturer's
  /// "extend time" grant — the BullMQ auto-submit job and the overdue
  /// safety net both key off this instead of the static exam duration.
  auto_submit_at DateTime?
  questions   SubmissionQuestions[]
  violations  ExamViolation[]
  exam        Exam                  @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student     User                  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  session     ExamSession?

  @@index([exam_id])
  @@index([student_id])
  @@index([status])
  /// Note: Partial unique index "submissions_active_exam_student_unique" on ("exam_id", "student_id")
  /// WHERE "is_deleted" = false AND "status" = 'IN_PROGRESS' is managed via custom SQL migration.
  @@map("submissions")
}

model Question {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted      Boolean               @default(false)
  deleted_at      DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  question_text   String
  chapter_id      String                @db.Uuid
  options         String?
  correct_answer  String?
  question_type   QuestionType
  question_format QuestionFormat
  submissions     SubmissionQuestions[]
  exams           ExamQuestions[]
  files           QuestionFiles[]
  chapter         Chapter               @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  importItems     QuestionImportItem[]
  generationItem  QuestionGenerationItem?

  @@index([chapter_id])
  @@index([question_type, question_format])
  @@map("questions")
}

model QuestionFiles {
  question_id String   @db.Uuid
  file_id     String   @db.Uuid
  order       Int
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  file        File     @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@unique([question_id, file_id])
  @@map("question_files")
}

model ExamQuestions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted  Boolean   @default(false)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  exam_id     String    @db.Uuid
  question_id String    @db.Uuid
  exam        Exam      @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, question_id])
  @@map("exam_questions")
}

model ExamSession {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String     @unique @db.Uuid
  entered_at    DateTime   @default(now())
  last_ping     DateTime   @default(now())
  is_active     Boolean    @default(true)
  submission    Submission @relation(fields: [submission_id], references: [id])

  @@index([is_active, last_ping])
  @@map("exam_sessions")
}

/// One row per proctoring signal (tab hidden, window blur, fullscreen exit,
/// connection loss...). Append-only audit trail — no soft-delete, no
/// updated_at, cascade-deletes with its submission — same shape as
/// ExamSession, the closest existing analogue (machine-generated runtime
/// telemetry, never user-edited).
model ExamViolation {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime            @default(now())
  submission_id String              @db.Uuid
  exam_id       String              @db.Uuid
  student_id    String              @db.Uuid
  type          ExamViolationType
  source        ExamViolationSource @default(CLIENT)
  occurred_at   DateTime            @default(now())
  client_time   DateTime?
  duration_ms   Int?
  submission    Submission          @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  exam          Exam                @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student       User                @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([exam_id, occurred_at])
  @@index([submission_id, type, occurred_at])
  @@map("exam_violations")
}

/// An explicit, lecturer-granted exception letting one student start a new
/// attempt at an official exam despite already having a COMPLETED
/// submission (official exams otherwise hard-block re-entry). Deliberately
/// separate from deleting a submission: the completed attempt and its score
/// stay on record, this just authorizes one more try. `consumed_at` is set
/// the moment `startExam` uses the grant to create the new attempt, so an
/// unconsumed row is a standing, still-usable exception.
model ExamRetryGrant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime  @default(now())
  exam_id     String    @db.Uuid
  student_id  String    @db.Uuid
  granted_by  String    @db.Uuid
  consumed_at DateTime?
  exam        Exam      @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student     User      @relation("ExamRetryGrantStudent", fields: [student_id], references: [id], onDelete: Cascade)
  granter     User      @relation("ExamRetryGrantGranter", fields: [granted_by], references: [id], onDelete: Cascade)

  @@index([exam_id, student_id, consumed_at])
  @@map("exam_retry_grants")
}

model SubmissionQuestions {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted    Boolean    @default(false)
  deleted_at    DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  submission_id String     @db.Uuid
  question_id   String     @db.Uuid
  options       String?
  answer        String?
  score         Decimal?   @db.Decimal(10, 2)
  is_correct    Boolean    @default(false)
  order         Int        @default(0)
  submission    Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question      Question   @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_id])
  @@index([submission_id, order])
  @@map("submission_questions")
}

model ExamRegistration {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted Boolean            @default(false)
  deleted_at DateTime?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  exam_id    String             @db.Uuid
  student_id String             @db.Uuid
  status     RegistrationStatus @default(PENDING)
  exam       Exam               @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student    User               @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, student_id])
  @@index([exam_id, status])
  @@index([student_id])
  @@map("exam_registrations")
}

model File {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  url          String
  s3_key       String?
  type         FileType
  size         Int?
  entity_type  String?
  entity_id    String?
  uploaded_by  String                @db.Uuid
  uploaded_at  DateTime              @default(now())
  status       FileStatus            @default(PENDING)
  uploadedBy   User                  @relation("UploadedFiles", fields: [uploaded_by], references: [id], onDelete: Cascade)
  questions    QuestionFiles[]
  importAssets QuestionImportAsset[]

  @@index([entity_type, entity_id])
  @@index([uploaded_by])
  @@map("files")
}

model QuestionImport {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt
  created_by         String                   @db.Uuid
  topic_id           String                   @db.Uuid
  default_chapter_id String?                  @db.Uuid
  exam_id            String?                  @db.Uuid
  source_type        QuestionImportSourceType
  status             QuestionImportStatus     @default(UPLOADING)
  source_name        String
  source_mime_type   String
  source_size        Int
  source_s3_key      String
  total_items        Int                      @default(0)
  valid_items        Int                      @default(0)
  invalid_items      Int                      @default(0)
  committed_items    Int                      @default(0)
  skipped_items      Int                      @default(0)
  error_message      String?
  expires_at         DateTime
  committed_at       DateTime?
  creator            User                     @relation(fields: [created_by], references: [id], onDelete: Cascade)
  topic              Topic                    @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  defaultChapter     Chapter?                 @relation("QuestionImportDefaultChapter", fields: [default_chapter_id], references: [id], onDelete: SetNull)
  exam               Exam?                    @relation(fields: [exam_id], references: [id], onDelete: SetNull)
  items              QuestionImportItem[]

  @@index([created_by, created_at(sort: Desc)])
  @@index([status, expires_at])
  @@map("question_imports")
}

model QuestionImportItem {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime                 @default(now())
  updated_at   DateTime                 @updatedAt
  import_id    String                   @db.Uuid
  source_index Int
  source_code  String?
  chapter_id   String?                  @db.Uuid
  data         Json
  errors       Json
  warnings     Json
  fingerprint  String?
  status       QuestionImportItemStatus
  question_id  String?                  @db.Uuid
  import       QuestionImport           @relation(fields: [import_id], references: [id], onDelete: Cascade)
  chapter      Chapter?                 @relation("QuestionImportItemChapter", fields: [chapter_id], references: [id], onDelete: SetNull)
  question     Question?                @relation(fields: [question_id], references: [id], onDelete: SetNull)
  assets       QuestionImportAsset[]

  @@unique([import_id, source_index])
  @@index([import_id, status])
  @@index([fingerprint])
  @@map("question_import_items")
}

model QuestionImportAsset {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime           @default(now())
  item_id     String             @db.Uuid
  temp_s3_key String
  name        String
  mime_type   String
  size        Int
  order       Int
  file_id     String?            @db.Uuid
  item        QuestionImportItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  file        File?              @relation(fields: [file_id], references: [id], onDelete: SetNull)

  @@index([item_id, order])
  @@map("question_import_assets")
}

model QuestionGenerationBatch {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime                      @default(now())
  updated_at       DateTime                      @updatedAt
  created_by       String                        @db.Uuid
  topic_id         String                        @db.Uuid
  chapter_id       String                        @db.Uuid
  contract_version String                        @default("text-generation.v1")
  idempotency_key  String                        @db.VarChar(128)
  request_hash     String                        @db.Char(64)
  source_text      String
  question_type    QuestionType                  @default(SINGLE_CHOICE)
  question_format  QuestionFormat
  requested_count  Int
  language         String                        @default("vi")
  consented_at     DateTime
  status           QuestionGenerationBatchStatus @default(QUEUED)
  total_items      Int                           @default(0)
  error_code       String?
  execution_id     String?                       @db.Uuid
  lease_expires_at DateTime?
  started_at       DateTime?
  finished_at      DateTime?
  creator          User                          @relation(fields: [created_by], references: [id], onDelete: Cascade)
  topic            Topic                         @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  chapter          Chapter                       @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  items            QuestionGenerationItem[]
  attempts         QuestionGenerationAttempt[]
  outbox           QuestionGenerationOutbox?
  reviews          QuestionGenerationReview[]

  @@unique([created_by, idempotency_key])
  @@index([created_by, created_at(sort: Desc)])
  @@index([status, lease_expires_at])
  @@map("question_generation_batches")
}

model QuestionGenerationItem {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime                     @default(now())
  updated_at    DateTime                     @updatedAt
  batch_id      String                       @db.Uuid
  source_index  Int
  revision      Int                          @default(1)
  original_data Json
  data          Json
  errors        Json
  warnings      Json
  fingerprint   String                       @db.Char(64)
  status        QuestionGenerationItemStatus @default(VALID)
  question_id   String?                      @unique @db.Uuid
  reviewed_by   String?                      @db.Uuid
  reviewed_at   DateTime?
  committed_at  DateTime?
  batch         QuestionGenerationBatch      @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  question      Question?                    @relation(fields: [question_id], references: [id], onDelete: SetNull)
  reviews       QuestionGenerationReview[]

  @@unique([batch_id, source_index])
  @@index([batch_id, status])
  @@map("question_generation_items")
}

model QuestionGenerationReview {
  id            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime                       @default(now())
  batch_id      String                         @db.Uuid
  item_id       String                         @db.Uuid
  actor_id      String                         @db.Uuid
  action        QuestionGenerationReviewAction
  revision      Int
  before_status QuestionGenerationItemStatus
  after_status  QuestionGenerationItemStatus
  before_data   Json
  after_data    Json
  question_id   String?                        @db.Uuid
  batch         QuestionGenerationBatch        @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  item          QuestionGenerationItem         @relation(fields: [item_id], references: [id], onDelete: Cascade)
  actor         User                           @relation(fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([batch_id, created_at])
  @@index([item_id, revision])
  @@map("question_generation_reviews")
}

model QuestionGenerationAttempt {
  id          String                          @id @db.Uuid
  batch_id    String                          @unique @db.Uuid
  started_at  DateTime                        @default(now())
  finished_at DateTime?
  status      QuestionGenerationAttemptStatus @default(RUNNING)
  error_code  String?
  result      Json?
  batch       QuestionGenerationBatch         @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@map("question_generation_attempts")
}

model QuestionGenerationOutbox {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id         String                  @unique @db.Uuid
  created_at       DateTime                @default(now())
  dispatched_at    DateTime?
  next_dispatch_at DateTime                @default(now())
  dispatch_count   Int                     @default(0)
  error_code       String?
  batch            QuestionGenerationBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([next_dispatch_at])
  @@map("question_generation_outbox")
}

model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_deleted   Boolean          @default(false)
  deleted_at   DateTime?
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  recipient_id String           @db.Uuid
  sender_id    String?          @db.Uuid
  type         NotificationType
  title        String
  content      String
  target_id    String?
  target_type  String?
  is_read      Boolean          @default(false)
  link         String?
  recipient    User             @relation("ReceivedNotifications", fields: [recipient_id], references: [id], onDelete: Cascade)
  sender       User?            @relation("SentNotifications", fields: [sender_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, is_read])
  @@index([created_at(sort: Desc)])
  @@map("notifications")
}
