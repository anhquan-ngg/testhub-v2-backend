{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.dev.json",
    "assets": [
      {
        "include": "../generated/**/*",
        "outDir": "./generated",
        "watchAssets": true
      }
    ]
  }
}
