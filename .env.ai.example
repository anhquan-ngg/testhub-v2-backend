# Append these settings to your existing backend environment; do not replace it.
AI_QUESTION_GENERATION_ENABLED=false
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
# Same value as INTERNAL_API_TOKEN in the Python service; 32-256 visible ASCII.
AI_SERVICE_INTERNAL_TOKEN=
# Must exceed the Python grounded deadline (max(75000, GENERATION_TIMEOUT_MS + 15000), or
# GROUNDED_GENERATION_TIMEOUT_MS) plus internal-network allowance; max 185000.
# 35000 suits Gemini defaults; use ~130000 with GENERATION_TIMEOUT_MS=110000 on 9Router.
AI_SERVICE_TIMEOUT_MS=35000
# Binary extraction timeout <=55000 ms; Python total deadline is 45000 ms.
DOCUMENT_SERVICE_TIMEOUT_MS=55000
# Document-mode grounded generation only: requeue the batch (not the HTTP call) with exponential backoff
# when Python reports a retryable, pre-LLM failure (embedding rate limit/timeout, capacity, storage).
# Max requeues per batch; 0 disables, max 10. Delays: 15s base, 120s cap, +/-20% jitter.
AI_GENERATION_MAX_RETRIES=3

# The API and dedicated AI worker use the same DB and AI configuration.
# Reuse the existing REDIS_URL / REDIS_PASSWORD configuration (do not duplicate it).
# After reviewing/applying migrations locally and building: npm run start:ai-worker
# Documents use a separate process: npm run start:document-worker

# Enable only after business migration and Python rag SQL setup.
AI_RAG_ENABLED=false
