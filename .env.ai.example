# Append these settings to your existing backend environment; do not replace it.
AI_QUESTION_GENERATION_ENABLED=false
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
# Same value as INTERNAL_API_TOKEN in the Python service; 32-256 visible ASCII.
AI_SERVICE_INTERNAL_TOKEN=
# Must exceed Python GENERATION_TIMEOUT_MS plus internal-network allowance.
AI_SERVICE_TIMEOUT_MS=35000

# The API and dedicated AI worker use the same DB and AI configuration.
# Reuse the existing REDIS_URL / REDIS_PASSWORD configuration (do not duplicate it).
# After reviewing/applying migrations locally and building: npm run start:ai-worker
